#!/bin/sh
# WipeOS pre-commit hook: lint what is staged, and refuse the commit if
# lint finds anything (scripts/lint.sh does the work).
#
# Git never enables hooks from a clone by itself; each clone opts in once:
#   git config core.hooksPath .githooks
# To skip it for one commit (a work-in-progress checkpoint, say):
#   git commit --no-verify
exec "$(git rev-parse --show-toplevel)/scripts/lint.sh" --staged
