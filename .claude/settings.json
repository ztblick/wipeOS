{
  "permissions": {
    "ask": [
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/hooks/**)",
      "Edit(/scripts/lint.sh)",
      "Edit(/scripts/lint-selftest.sh)",
      "Edit(/.checkpatch.conf)",
      "Edit(/.githooks/**)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/.git/**)"
    ],
    "deny": [
      "Edit(/docs/design.md)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-lint.py",
            "args": [],
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Checking for lint bypasses"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-lint.py",
            "args": [],
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Checking for lint bypasses"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/lint-c.sh",
            "args": [],
            "timeout": 120,
            "statusMessage": "Linting the C change"
          }
        ]
      }
    ]
  }
}