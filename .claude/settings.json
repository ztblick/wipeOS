{
  "permissions": {
    "ask": [
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/hooks/**)",
      "Edit(/scripts/lint.sh)",
      "Edit(/scripts/lint-selftest.sh)",
      "Edit(/scripts/hooks-selftest.sh)",
      "Edit(/.checkpatch.conf)",
      "Edit(/.githooks/**)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/.git/**)",
      "Edit(/scripts/fetch-checkpatch.sh)",
      "Edit(/.github/workflows/**)",
      "Write(/.github/workflows/**)"
    ],
    "deny": [
      "Edit(/docs/design.md)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-lint.py",
            "args": [],
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Checking for lint bypasses"
          },
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-build.py"],
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Checking the build and environment rules"
          },
          {
          "type": "command",
          "command": "python3",
          "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-git.py"],
          "timeout": 10,
          "onFailure": "block",
          "statusMessage": "Checking the git workflow rules"
        }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-lint.py",
            "args": [],
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Checking for lint bypasses"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/lint-c.sh",
            "args": [],
            "timeout": 120,
            "statusMessage": "Linting the C change"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/check-index.py"],
            "timeout": 30,
            "statusMessage": "Checking context/INDEX.md"
          }
        ]
      }
    ]
  }
}